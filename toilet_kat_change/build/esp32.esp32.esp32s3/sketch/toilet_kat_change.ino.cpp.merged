};

OTAState otaState = OTA_IDLE;
inline bool otaTransferInProgress() {
  return (otaState == OTA_PREPARING || otaState == OTA_RECEIVING ||
          otaState == OTA_VALIDATING || otaState == OTA_FINALIZING);
}
